{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (device)",
            "type": "shell",
            "command": "bash",
            "args": ["-c", ". $IDF_PATH/export.sh && make build"],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Flash to device",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Monitor device",
            "type": "shell",
            "command": "make",
            "args": ["monitor"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+): error: (.*)$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^--- idf_monitor",
                    "endsPattern": "^--- exit ---"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Build, Flash & Monitor",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "make build && make flash && make monitor"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Start simulator",
            "type": "shell",
            "command": "make",
            "args": ["sim"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Starting simulator",
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting simulator",
                    "endsPattern": "^simulator exited"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Restart simulator",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "pkill -f 'lib/Simulator/build/simulator$' || true; sleep 1; make sim"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Starting simulator",
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting simulator",
                    "endsPattern": "^simulator exited"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build simulator",
            "type": "shell",
            "command": "make",
            "args": ["sim-build"],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "make",
            "args": ["test"],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Run tests (Kindle)",
            "type": "shell",
            "command": "make",
            "args": ["test-kindle"],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Lint & format",
            "type": "shell",
            "command": "bash",
            "args": ["-c", ". $IDF_PATH/export.sh && make clang-tidy"],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Clean builds",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
